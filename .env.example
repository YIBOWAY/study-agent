# OpenAI-compatible API settings
# Notes:
# - Keep secrets in .env, never commit them.
# - This project currently uses an OpenAI-compatible /chat/completions endpoint.
# - xairouter can be used here as long as the configured base URL supports that path.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.xairouter.com/v1
LLM_MODEL=gpt-5.4
LLM_TIMEOUT=60

# Embedding settings. Leave API key/base URL empty to reuse the main LLM settings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_TIMEOUT=60

# Qdrant settings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=phase2_chunks

# Cohere rerank settings
RERANK_API_KEY=
RERANK_BASE_URL=https://api.cohere.com/v2
RERANK_MODEL=rerank-v3.5

# RAG behavior
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=20
RAG_FINAL_K=5

# Optional provider metadata for your own record-keeping
LLM_PROVIDER=xai

# App settings
APP_NAME="Phase0-1 LLM Backend"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
