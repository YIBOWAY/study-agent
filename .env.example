# App
APP_NAME=Research Agent Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# LLM
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.xairouter.com/v1
LLM_MODEL=gpt-5.4
LLM_TIMEOUT=60

# Embeddings
# If these are empty, the app reuses LLM_API_KEY and LLM_BASE_URL.
# That only works when the provider also supports /embeddings for EMBEDDING_MODEL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_TIMEOUT=60

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=phase2_chunks

# Rerank
RERANK_API_KEY=
RERANK_BASE_URL=https://api.cohere.com/v2
RERANK_MODEL=rerank-v3.5
RERANK_FAIL_SOFT=true

# Web search
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Tool / research limits
ENABLE_CODE_EXECUTION_TOOL=false
TOOL_CALL_MAX_ITERATIONS=10
TOOL_CALL_TIMEOUT=30
RESEARCH_MAX_ITERATIONS=3
RESEARCH_TOP_K=5

# RAG behavior
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=20
RAG_FINAL_K=5

# Memory
MEMORY_DATA_DIR=data/memory
MEMORY_MAX_INSIGHTS=100
MEMORY_SESSION_TTL=3600

# MCP
MCP_SERVER_NAME=research-agent-tools
MCP_SERVER_VERSION=0.1.0
# Format: name1:cmd1 args1 args2|name2:cmd2 args
MCP_EXTERNAL_SERVERS=

# Guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_STRICT_MODE=false
GUARDRAILS_ALLOWED_TOOLS=get_current_time,calculate,search_knowledge_base,web_search,execute_python
GUARDRAILS_ALLOWED_MCP_TOOLS=

# Observability
TRACING_ENABLED=true
TRACING_DB_PATH=data/traces.db

# Demo API key protection
API_KEY_REQUIRED=false
API_KEY=

# Frontend demo
BACKEND_URL=http://localhost:8000
